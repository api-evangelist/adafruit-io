                "description": "a valid username string"
              },
              {
                "name": "type",
                "value": "",
                "type": "path"
              },
              {
                "name": "type_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns Permission based on ID"
