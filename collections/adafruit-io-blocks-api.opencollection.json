              {
                "name": "username",
                "value": "",
                "type": "path",
                "description": "a valid username string"
              },
              {
                "name": "dashboard_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns Block based on ID"
        },
        {
          "info": {
