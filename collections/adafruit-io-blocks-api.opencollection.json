{
  "opencollection": "1.0.0",
  "info": {
    "name": "Adafruit IO REST Activities Blocks API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-AIO-Key",
      "value": "{{X-AIO-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
